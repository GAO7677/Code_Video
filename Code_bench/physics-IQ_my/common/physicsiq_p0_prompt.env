# Canonical negative prompt for newly launched Physics-IQ Verified P0 runs.
#
# This is the long prompt used by PhysRVG-72f-adapted. Keep the version and
# digest next to the literal so run manifests/configs can record exactly which
# prompt was used. Historical run-specific configs are intentionally not
# rewritten when their recorded prompt differs.
PHYSIQ_P0_NEGATIVE_PROMPT_VERSION='physrvg-72f-adapted-long-v1'
PHYSIQ_P0_NEGATIVE_PROMPT_SHA256='ce96e0324e4b54ce4b6e867f669ca520952e1a34cc116543516b1897f0d3c47e'
PHYSIQ_P0_NEGATIVE_PROMPT='色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走'

readonly PHYSIQ_P0_NEGATIVE_PROMPT_VERSION
readonly PHYSIQ_P0_NEGATIVE_PROMPT_SHA256
readonly PHYSIQ_P0_NEGATIVE_PROMPT
