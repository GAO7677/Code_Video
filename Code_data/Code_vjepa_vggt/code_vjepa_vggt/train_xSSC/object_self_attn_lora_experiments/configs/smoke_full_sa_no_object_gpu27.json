{
  "extends": "full_sa_no_object.json",
  "experiment": {
    "name": "smoke_full_sa_no_object_gpu27"
  },
  "launch": {
    "gpu_set": "2,7",
    "num_processes": 2,
    "main_process_port": 29527
  },
  "paths": {
    "output_root": "/data/gaoya/agent-data/checkpoints/xssc_object_self_attn_lora_smoke"
  },
