{
  "extends": "full_sa_no_object.json",
  "experiment": {
    "name": "full_sa_no_object_kubric100_gpu7_1000steps",
    "description": "Full-SA No-Object dataset ablation trained on 100% PhyCo Kubric"
  },
  "launch": {
    "gpu_set": "7",
    "num_processes": 1,
    "main_process_port": 29577
  },
  "data": {
    "mixture_pybullet_ratio": 0.0,
    "mixture_kubric_ratio": 1.0,
    "mixture_openvid_ratio": 0.0
  },
  "optimization": {
    "train_batch_size_per_gpu": 1,
    "gradient_accumulation_steps": 8,
    "max_train_steps": 1000
  },
  "checkpointing": {
    "save_steps": 500,
    "max_checkpoints_keep": 2,
    "resume_from": null
  },
  "logging": {
    "wandb_name": "full_sa_no_object_kubric100_gpu7_1000steps"
  }
}
